<view class="app">
  <block wx:if="{{page === 'home'}}">
    <view class="brand"><image class="logo" src="/assets/olive-tree-logo.png" mode="aspectFit" /></view>
    <view class="search"><input value="{{queryInput}}" bindinput="onQueryInput" bindconfirm="onSearch" confirm-type="search" placeholder="搜索交流者、课程..." /><button bindtap="onSearch"><text class="search-icon">⌕</text></button></view>
    <view class="shortcuts"><button wx:for="{{shortcuts}}" wx:key="page" class="shortcut" data-page="{{item.page}}" bindtap="openFeature"><view class="shortcut-icon"><image src="{{item.iconSrc}}" mode="aspectFit" /></view><text>{{item.label}}</text></button></view>
    <view class="filter-group"><text class="filter-label">学科</text><scroll-view class="toolbar" scroll-x="true"><view class="chips"><button class="chip {{subjectFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="setSubject">全部</button><button wx:for="{{subjects}}" wx:key="*this" class="chip {{subjectFilter === item ? 'active' : ''}}" data-filter="{{item}}" bindtap="setSubject">{{item}}</button></view></scroll-view></view>
    <view class="filter-group"><text class="filter-label">等级</text><scroll-view class="toolbar" scroll-x="true"><view class="chips"><button class="chip {{levelFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="setLevel">全部</button><button wx:for="{{levels}}" wx:key="*this" class="chip {{levelFilter === item ? 'active' : ''}}" data-filter="{{item}}" bindtap="setLevel">{{item}}</button></view></scroll-view></view>
    <view class="list"><view wx:for="{{filteredTeachers}}" wx:key="name" class="teacher"><view class="teacher-top"><view class="portrait {{item.color}}">{{item.avatar}}</view><view class="teacher-info"><text class="teacher-name">{{item.name}}</text><text class="school">{{item.school}}</text><view class="rating">{{item.stars}} <text>{{item.level}}</text></view></view><button class="view" data-index="{{index}}" bindtap="showTeacher">查看详情</button></view><view class="teacher-meta"><view class="subjects"><text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text></view><text class="payment">{{item.payment}}</text></view></view></view><view wx:if="{{filteredTeachers.length === 0}}" class="empty">暂未找到符合条件的交流者</view>
  </block>
  <block wx:elif="{{page === 'messages'}}"><view class="sub-page message-page"><text class="page-title">消息</text>
    <view wx:if="{{!loggedIn}}" class="feature-card"><text class="feature-card-desc">登录后查看与发送站内消息。</text><button class="primary" bindtap="showLogin">登录 / 注册</button></view>
    <block wx:else><view class="feature-card">
      <text class="feature-card-desc">站内消息仅在本小程序收发；未接入微信订阅通知。对方可在账户设置复制编号。</text>
      <input class="settings-input" placeholder="接收人账户编号" value="{{recipientId}}" bindinput="onRecipient" />
      <textarea class="message-input" maxlength="1000" placeholder="输入消息（最多1000字）" value="{{messageText}}" bindinput="onMessageText" />
      <button class="primary" loading="{{messageBusy}}" disabled="{{messageBusy}}" bindtap="sendMessage">发送消息</button>
      <button class="text-button" bindtap="loadMessages">刷新消息</button>
    </view>
    <view wx:if="{{messageItems.length === 0}}" class="data-empty">暂无消息，新的互动会显示在这里</view>
    <view wx:for="{{messageItems}}" wx:key="id" class="feature-card message-card"><text class="feature-card-title">{{item.mine ? '发给' : '来自'}} {{item.peerName}}</text><text class="message-body">{{item.text}}</text><text class="feature-card-desc">{{item.createdAt}} · {{item.readAt ? '已读' : '未读'}}</text><button class="text-button" data-peer="{{item.peerId}}" bindtap="replyMessage">回复此账户</button></view>
    </block></view></block>
  <block wx:elif="{{page === 'profile'}}"><view class="sub-page profile-page"><text class="page-title">个人</text><view class="login-card profile-login-card"><image wx:if="{{avatarSrc}}" class="login-avatar avatar-image" src="{{avatarSrc}}" mode="aspectFill" /><view wx:else class="login-avatar"></view><text class="login-title">{{loggedIn ? user.nickname + '，欢迎回来' : '登录后享受完整服务'}}</text><text class="login-desc">{{loggedIn ? '预约、缴费信息和收藏内容已同步' : '同步预约、缴费信息和收藏内容'}}</text><button class="primary" disabled="{{loggedIn}}" bindtap="showLogin">{{loggedIn ? '已登录' : '登录 / 注册'}}</button></view><view class="account-menu"><button class="account-item register" bindtap="showRegister"><view class="cap-icon"><view class="cap-top"></view><view class="cap-bowl"></view><view class="cap-tassel"></view></view><view class="register-copy"><text>注册成为交流者</text><text>实名认证后，授权提供更加专业的交流信息</text></view><text class="chevron">›</text></button><button class="account-item" data-mode="payments" bindtap="openAccount"><view class="account-symbol payment-symbol"></view><text class="account-label">缴费信息</text><text class="row-chevron">›</text></button><button class="account-item" data-mode="appointments" bindtap="openAccount"><view class="account-symbol appointment-symbol"></view><text class="account-label">我的预约</text><text class="row-chevron">›</text></button><button class="account-item" data-mode="favorites" bindtap="openAccount"><text class="account-symbol heart-symbol">♡</text><text class="account-label">收藏</text><text class="row-chevron">›</text></button><button class="account-item" data-mode="settings" bindtap="openAccount"><view class="account-symbol settings-symbol"><view></view></view><text class="account-label">账户设置</text><text class="row-chevron">›</text></button></view></view></block>
  <block wx:else><view class="sub-page feature-page"><view class="feature-head"><button class="back" bindtap="goBack">←</button><text class="feature-title">{{featureTitle}}</text></view>
    <block wx:if="{{accountMode === 'payments'}}"><view class="feature-card"><text class="feature-card-title">缴费信息</text><text class="feature-card-desc">{{capabilities.paymentNotice || '真实微信支付未开通，当前仅演示订单，不扣款。'}}</text><button class="text-button" data-kind="payment" bindtap="showPermission">查看开通条件</button><button class="secondary-button" disabled="{{orderBusy || !capabilities.demoPayment}}" loading="{{orderBusy}}" bindtap="addPayment">创建 ¥1 演示订单</button><view wx:if="{{accountItems.length === 0}}" class="data-empty">暂无订单</view>
      <view wx:for="{{accountItems}}" wx:key="id" class="order-row"><text>{{item.title}}</text><text>¥{{item.amount}} · {{item.status}}</text>
      <view wx:if="{{item.mode === 'demo'}}" class="order-actions"><button wx:if="{{item.status === '待支付'}}" class="secondary-button" disabled="{{orderBusy}}" data-id="{{item.id}}" data-action="pay" bindtap="orderAction">模拟付款</button><button wx:if="{{item.status === '待支付'}}" class="text-button" disabled="{{orderBusy}}" data-id="{{item.id}}" data-action="cancel" bindtap="orderAction">取消订单</button><button wx:if="{{item.status === '演示已支付'}}" class="text-button" disabled="{{orderBusy}}" data-id="{{item.id}}" data-action="refund" bindtap="orderAction">模拟退款</button></view></view></view></block>
    <block wx:elif="{{accountMode === 'appointments'}}"><view class="feature-card"><text class="feature-card-title">我的预约</text><view wx:for="{{accountItems}}" wx:key="id" class="data-row"><text>{{item.teacherName}}</text><text>{{item.status}}</text><button wx:if="{{item.status === '待确认'}}" class="text-button" data-id="{{item.id}}" bindtap="cancelAppointment">取消</button></view><text class="feature-card-desc">首页为示例交流者；预约仅记录意向，尚未对接交流者确认或排期。</text><view wx:if="{{accountItems.length === 0}}" class="data-empty">暂未预约交流者，可从交流者详情发起咨询。</view></view></block>
    <block wx:elif="{{accountMode === 'favorites'}}"><view class="feature-card"><text class="feature-card-title">收藏</text><view wx:for="{{accountItems}}" wx:key="id" class="data-row"><text>{{item.teacherName}}</text><button class="text-button" data-id="{{item.id}}" bindtap="removeFavorite">取消收藏</button></view><view wx:if="{{accountItems.length === 0}}" class="data-empty">暂无收藏，可在交流者详情中收藏。</view></view></block>
    <block wx:elif="{{accountMode === 'settings'}}"><view class="feature-card settings-card"><text class="feature-card-title">账户设置</text><text class="account-id">账户编号：{{user.id}}</text><button class="text-button" bindtap="copyAccountId">复制账户编号（用于站内消息）</button><image wx:if="{{avatarSrc}}" class="settings-avatar" src="{{avatarSrc}}" mode="aspectFill" /><view wx:else class="settings-avatar"></view><button class="secondary-button" bindtap="chooseAvatar">上传头像</button><input class="settings-input" value="{{settingNickname}}" maxlength="16" placeholder="输入昵称" bindinput="onSettingNickname" /><button class="primary" bindtap="saveSettings">保存设置</button><button class="text-button" bindtap="logout">退出登录</button></view></block>
    <block wx:elif="{{page === 'agents'}}"><view wx:for="{{agentCards}}" wx:key="title" class="feature-card agent-card" data-kind="content" bindtap="showPermission"><image src="{{item.iconSrc}}" mode="aspectFit" /><view><text class="feature-card-title">{{item.title}}</text><text class="feature-card-desc">{{item.desc}}</text></view></view></block>
    <block wx:else><view class="feature-card"><text class="feature-card-title">{{featureHeading}}</text><text class="feature-card-desc">{{featureDescription}}</text></view><view class="feature-card placeholder"><view wx:if="{{page === 'courses'}}" class="monitor-symbol">▷</view><image wx:else src="{{featureIconSrc}}" mode="aspectFit" /><text class="feature-card-desc">{{capabilities.contentNotice || '服务尚未接入，暂未开放'}}</text><button class="text-button" data-kind="content" bindtap="showPermission">查看说明</button></view></block>
  </view></block>
  <view class="bottom-nav"><button class="nav-btn {{page === 'home' ? 'active' : ''}}" data-page="home" bindtap="switchPage"><text class="nav-icon">⌂</text><text>首页</text></button><button class="nav-btn {{page === 'messages' ? 'active' : ''}}" data-page="messages" bindtap="switchPage"><text class="nav-icon">◌</text><text>消息</text></button><button class="nav-btn {{page === 'profile' ? 'active' : ''}}" data-page="profile" bindtap="switchPage"><text class="nav-icon">♙</text><text>个人</text></button></view>
  <view wx:if="{{showTeacherModal}}" class="mask" bindtap="hideTeacher"><view class="modal" catchtap="stopPropagation"><view class="modal-top"><view><view class="rating">{{selectedTeacher.stars}} {{selectedTeacher.level}}</view><text class="modal-title">{{selectedTeacher.name}}</text><text class="school">{{selectedTeacher.school}}</text></view><button class="close" bindtap="hideTeacher">×</button></view><text class="modal-desc">示例交流者，尚未绑定真实账户。收藏与预约意向可以保存；真实沟通请前往消息页填写对方账户编号。</text><view class="modal-grid"><view><text>{{selectedTeacher.payment}}</text><text>收费方式</text></view><view><text>略</text><text>教学经验</text></view><view><text>略</text><text>累计学员</text></view></view><view class="detail-list"><view><text>简历信息</text><text>略</text></view><view><text>联系方式</text><text>略</text></view></view><button class="secondary-button" bindtap="toggleFavorite">{{favoriteActive ? '已收藏' : '收藏交流者'}}</button><button class="primary modal-primary" bindtap="consultTeacher">{{consultSent ? '已加入我的预约' : '咨询交流者'}}</button></view></view>
  <view wx:if="{{showLoginPanel}}" class="mask" bindtap="hideLogin"><view class="modal login-modal" catchtap="stopPropagation"><view class="modal-top"><view><text class="modal-title">登录 / 注册</text><text class="modal-desc">请选择登录方式</text></view><button class="close" bindtap="hideLogin">×</button></view><view class="login-form quick-login-form"><checkbox-group bindchange="onAgreementChange"><label class="agreement-row"><checkbox value="agreed" checked="{{agreementAccepted}}" color="#19663b" /><text>我已阅读并同意《用户协议》与《商家隐私政策》</text></label></checkbox-group><view class="policy-links"><text data-kind="terms" bindtap="showAgreement">阅读用户协议</text><text data-kind="privacy" bindtap="showAgreement">阅读隐私政策</text></view><button class="primary" loading="{{loginBusy}}" disabled="{{!agreementAccepted || loginBusy}}" bindtap="wechatQuickLogin">微信快捷登录</button><button wx:if="{{capabilities.phoneLogin}}" class="secondary-button phone-quick-button" disabled="{{!agreementAccepted || loginBusy}}" open-type="getPhoneNumber" bindgetphonenumber="onPhoneQuickLogin">手机号一键登录</button><button wx:else class="secondary-button phone-quick-button" data-kind="phone" bindtap="showPermission">手机号一键登录（未开通）</button><text class="login-notice">首次微信登录自动创建账户。当前协议为演示版，正式上线前需运营方确认。</text></view></view></view>
  <view wx:if="{{showRegisterPanel}}" class="mask" bindtap="hideRegister"><view class="modal login-modal" catchtap="stopPropagation"><view class="modal-top"><view><text class="modal-title">注册成为交流者</text><text class="modal-desc">完成认证后即可提供专业信息</text></view><button class="close" bindtap="hideRegister">×</button></view><block wx:if="{{!registerSuccess}}"><view class="verify-intro">◈　为保障双方权益，请填写真实身份信息完成认证。</view><view class="login-form"><label>拍摄证件照<button class="upload-input" bindtap="chooseIdCard">{{idCardName || '选择图片'}}</button></label><label>学信网学籍证明<button class="upload-input" bindtap="chooseStudentId">{{studentIdName || '选择图片或 PDF'}}</button></label><label>手机号<input class="panel-input" placeholder="请输入本人手机号" type="number" maxlength="11" value="{{teacherPhone}}" bindinput="onTeacherPhone" /></label><button class="primary" bindtap="submitRegister">提交认证</button></view></block><view wx:else class="verify-success"><view>✓</view><text>认证提交成功</text><text>认证信息已保存，管理员审核后会通知你。</text><button class="primary" bindtap="hideRegister">完成</button></view></view></view>
</view>
